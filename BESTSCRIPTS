repeat task.wait() until game:IsLoaded()
task.wait()

local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/toeerolo-z/ethossuiterewrite/refs/heads/main/ethossuite.lua"))()

local gameName = "Hub"
pcall(function()
	local info = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
	if info and info.Name then gameName = info.Name end
end)

local Window = Library:CreateWindow({
	Title = "",
	GameName = gameName,
})

local GetScript = Window:AddCategory("GET THE SCRIPT")
local Tab = GetScript:AddTab(gameName)
local Box = Tab:AddGroupbox("")

Box:AddLabel("Thanks for all the support ❤️ We update every single day!")

Box:AddButton({
	Text = "GET THE SCRIPT HERE",
	Func = function()
		local link = "https://discord.gg/C4cTeqkpug"
		if setclipboard then setclipboard(link) end
		game.Players.LocalPlayer:Kick("Get The Script Here: discord.gg/C4cTeqkpug\n\nThanks for all the support ❤️\nWe Update Every Single Day")
	end,
})
